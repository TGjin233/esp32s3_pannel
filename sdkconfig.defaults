# ESP32-S3-WROOM-1-N8R8 (8MB flash + 8MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"

# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash 8MB
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Custom partition table: 4MB app (WiFi + MQTT + LVGL)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Octal PSRAM 8MB @ 80MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Log
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# LVGL 8 (Kconfig based, no lv_conf.h needed)
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
# SPI LCD expects big-endian RGB565, LVGL stores little-endian by default
CONFIG_LV_COLOR_16_SWAP=y
# LVGL uses stdlib malloc so big PNG/JPEG buffers can live in PSRAM
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
# PNG decoder (lodepng) for the album page
CONFIG_LV_USE_PNG=y
# lv_font_conv generates RLE compressed glyphs, LVGL must be able to decode them
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_DISP_DEF_REFR_PERIOD=10
CONFIG_LV_INDEV_DEF_READ_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_20=y
